# Copy to .env and fill in real values. Never commit .env.

# apps/api
API_PORT=3461
DB_PATH=./data/dev.sqlite
CORS_ORIGINS=http://localhost:3460
SEED_ON_BOOT=1
# Optional. Without it, soft routing calls fall back to rules and are stamped "UNVERIFIED BY JEV".
JEV_API_KEY=
# Optional. Without it, CV summaries are off; routing never depends on them.
OPENAI_API_KEY=

# apps/web
WEB_PORT=3460
API_URL=http://localhost:3461

    "lint": "echo 'no lint configured for apps/api' && exit 0",
    "eval": "bun evals/run.ts"
  },
  "dependencies": {
    "@maxifyhiring/config": "workspace:*",
    "hono": "^4.6.0",
    "openai": "^4.70.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.7.0"
  }
}

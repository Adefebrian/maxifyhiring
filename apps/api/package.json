{
  "name": "@maxifyhiring/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'apps/api ships as TypeScript source, no build step needed for Bun runtime' && exit 0",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "test": "bun test",
